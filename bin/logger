#!/usr/bin/env bash

set -euo pipefail

typeset level="$1"
shift
typeset formatter="$1"
shift
typeset -a str_array=("$@")

color "[%{green}$(date "+%FT%T%z")%{reset}]"

case "$level" in
d)
  color '[%{magenta}调试%{reset}]'
  str_array=("${str_array[@]/#/"%{magenta}"}")
  ;;
i)
  color "[%{bold}信息%{reset}]"
  ;;
w)
  color "[%{yellow}警告%{reset}]"
  str_array=("${str_array[@]/#/"%{yellow}"}")
  ;;
e)
  color "[%{red}错误%{reset}]"
  str_array=("${str_array[@]/#/"%{red}"}")
  ;;
*)
  color "[%{bg_magenta}未知%{reset}]"
  str_array=("${str_array[@]/#/"%{bg_magenta}"}")
  ;;
esac

# shellcheck disable=SC2059
if [[ "$level" == "i" ]]; then
  color "${str_array[@]}"
else
  color "${str_array[@]/%/"%{reset}"}"
fi | xargs -- printf "$formatter"
